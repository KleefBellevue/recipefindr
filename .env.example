# Copy this file to ".env" and paste your keys in. Never commit .env to GitHub.

# https://console.groq.com/keys  (free)
GROQ_API_KEY=

# https://spoonacular.com/food-api/console#Profile  (free tier: 150 points/day)
SPOONACULAR_API_KEY=

